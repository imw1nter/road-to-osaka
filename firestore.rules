rules_version = '2';

// Road to Osaka – Firestore security rules
// Each user can only read and write their own runs, and every run must be valid.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidRun(run, runId) {
      return run.keys().hasAll(["id", "date", "type", "distance", "seconds", "effort", "notes", "createdAt"])
        && run.id == runId
        && run.date is string && run.date.size() == 10
        && run.type in ["Easy", "Long run", "Tempo", "Intervals", "Race"]
        && run.distance is number && run.distance > 0 && run.distance <= 200
        && run.seconds is int && run.seconds > 0
        && run.effort is int && run.effort >= 1 && run.effort <= 10
        && run.notes is string && run.notes.size() <= 300;
    }

    function isValidSettings(s) {
      return s.goalTime is int && s.goalTime >= 7200 && s.goalTime <= 28800
        && s.raceDate is string && s.raceDate.size() == 10
        && s.planStart is string && s.planStart.size() == 10
        && s.runDays is list && s.runDays.size() >= 3 && s.runDays.size() <= 6
        && s.longRunDay is int
        && s.overrides is map
        && s.updatedAt is number;
    }

    // Goal, paces, weekly structure, edited sessions and imported plan
    match /users/{userId}/profile/{docId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && docId == "settings" && isValidSettings(request.resource.data);
    }

    match /users/{userId}/runs/{runId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidRun(request.resource.data, runId);
    }
  }
}
